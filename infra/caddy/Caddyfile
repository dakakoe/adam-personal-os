# Phase 3 — Caddy reverse proxy.
# Lives on the droplet at /srv/memory/Caddyfile

{
    email {$CADDY_EMAIL}
}


{$CADDY_DOMAIN_MCP} {
    # MCP server runs as a systemd unit on the host, bound to 0.0.0.0:9000;
    # UFW + DO firewall block public 9000, so this proxy is the only path.
    # Bearer-token check is the gate: requests without the right Authorization
    # header get a flat 401, never reach the Python app.

    # Public /health for external uptime monitors (no auth). Returns 200
    # iff Caddy is up — it's intentionally a Caddy-level response, not a
    # proxy to the MCP app, so it's also valid when memory-mcp.service is
    # restarting. Use a more specific health check if you need to verify
    # the Python app too.
    @health path /health
    handle @health {
        respond "ok" 200
    }

    @authorized header Authorization "Bearer {$MCP_BEARER_TOKEN}"
    handle @authorized {
        reverse_proxy host.docker.internal:9000 {
            # MCP streamable-http uses SSE under the hood; disable buffering.
            flush_interval -1
        }
    }
    handle {
        respond "Unauthorized" 401
    }
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
# Add to /srv/memory/Caddyfile, then `docker compose restart caddy`.
# Same TLS scheme as the other example.com subdomains.

merge.example.com {
    encode zstd gzip

    # Machines: a bearer token bypasses Authelia entirely; merge_api validates it.
    @bearer header Authorization "Bearer *"
    handle @bearer {
        handle /api/* {
            reverse_proxy host.docker.internal:9100
        }
        handle {
            reverse_proxy host.docker.internal:3100
        }
    }

    # Humans: must pass Authelia (password + 2FA). On success, Caddy injects the
    # shared secret so merge_api trusts the Authelia Remote-Groups identity.
    handle {
        forward_auth memory-authelia-1:9091 {
            uri /api/authz/forward-auth
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }

        handle /api/* {
            reverse_proxy host.docker.internal:9100 {
                header_up X-Proxy-Secret {env.MERGE_PROXY_SECRET}
            }
        }
        handle {
            reverse_proxy host.docker.internal:3100 {
                header_up X-Proxy-Secret {env.MERGE_PROXY_SECRET}
            }
        }
    }

    log {
        output file /var/log/caddy/merge.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
# (Co-hosted sites — a marketing page, other apps — would get their own
# server blocks here. Removed from this template; add your own if needed.)


auth.example.com {
    reverse_proxy memory-authelia-1:9091
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
