[Unit]
Description=Sync Google Calendar events for all active accounts (Phase 4 v2)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/gmail
EnvironmentFile=/srv/memory/secrets/.env
# Small window — the planner only needs the next couple of weeks. Kept as
# its own unit (not folded into memory-gmail) so a missing calendar scope
# on one account never marks the mail sync failed.
Environment=GMAIL_CALENDAR_BACK_DAYS=1
Environment=GMAIL_CALENDAR_AHEAD_DAYS=14
ExecStart=/srv/memory/apps/gmail/.venv/bin/python -m gmail calendar-sync
StandardOutput=append:/srv/memory/logs/gcal.log
StandardError=append:/srv/memory/logs/gcal.log
