[Unit]
Description=Normalize raw → canonical for the personal contact-memory system
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/normalizer
EnvironmentFile=/srv/memory/secrets/.env
ExecStart=/srv/memory/apps/normalizer/.venv/bin/python -m normalizer
StandardOutput=append:/srv/memory/logs/normalizer.log
StandardError=append:/srv/memory/logs/normalizer.log
