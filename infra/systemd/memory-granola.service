[Unit]
Description=Poll Granola (official API) → merge suggestion inbox (replaces the Cowork relay)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/granola
EnvironmentFile=/srv/memory/secrets/.env
# Re-list the trailing window each run; the ingest endpoint is idempotent so
# already-processed notes are skipped without an LLM call.
Environment=GRANOLA_WINDOW_DAYS=7
ExecStart=/srv/memory/apps/granola/.venv/bin/python -m granola
StandardOutput=append:/srv/memory/logs/granola.log
StandardError=append:/srv/memory/logs/granola.log
