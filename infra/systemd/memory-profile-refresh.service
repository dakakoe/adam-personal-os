[Unit]
Description=Rebuild stale LLM profiles (memory.profile.last_built_at older than threshold)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/profile_builder
EnvironmentFile=/srv/memory/secrets/.env
# Only touch profiles that haven't been rebuilt in 30+ days. Steady state at
# ~3.8k profiles is ~125/day, but the FIRST run after enabling will see every
# existing profile as stale — PROFILE_LIMIT caps the per-day burst so we drip
# through the backlog over ~3 weeks instead of one giant burst.
Environment=PROFILE_REFRESH_OLDER_THAN_DAYS=30
Environment=PROFILE_LIMIT=200
# Sensitivity routing: sensitive contacts profile via local Ollama (narrative only).
Environment=OLLAMA_URL=http://127.0.0.1:11434
ExecStart=/srv/memory/apps/profile_builder/.venv/bin/python -m profile_builder
StandardOutput=append:/srv/memory/logs/profile_refresh.log
StandardError=append:/srv/memory/logs/profile_refresh.log
