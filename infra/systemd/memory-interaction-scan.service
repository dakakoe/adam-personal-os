[Unit]
Description=Scan recent 1:1 conversations for task/opportunity suggestions (Phase 3)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/interaction_scanner
EnvironmentFile=/srv/memory/secrets/.env
# Watermark model: scan any two-way thread with messages newer than its scan
# watermark. seed_days bounds staleness (and first-scan reach for never-seen
# threads); the per-run cap only delays — un-scanned threads stay candidates
# next run, so nothing is ever dropped by a time window.
Environment=SCANNER_SEED_DAYS=14
Environment=SCANNER_MAX_THREADS=40
# Sensitivity routing: sensitive contacts extract via local Ollama (fail-closed).
Environment=OLLAMA_URL=http://127.0.0.1:11434
ExecStart=/srv/memory/apps/interaction_scanner/.venv/bin/python -m interaction_scanner
StandardOutput=append:/srv/memory/logs/interaction_scan.log
StandardError=append:/srv/memory/logs/interaction_scan.log
