[Unit]
Description=Materialize due planned/recurring budget transactions
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/fin_planned
EnvironmentFile=/srv/memory/secrets/.env
ExecStart=/srv/memory/apps/fin_planned/.venv/bin/python -m fin_planned
StandardOutput=append:/srv/memory/logs/fin_planned.log
StandardError=append:/srv/memory/logs/fin_planned.log
