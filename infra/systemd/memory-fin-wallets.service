[Unit]
Description=Refresh crypto wallet holdings from chain
After=network.target memory-merge-api.service

[Service]
Type=oneshot
EnvironmentFile=/srv/memory/secrets/.env
ExecStart=/bin/bash -lc 'curl -sS --fail-with-body -X POST -H "Authorization: Bearer $MERGE_API_BEARER_TOKEN" http://127.0.0.1:9100/api/finance/sync-wallets'
StandardOutput=append:/srv/memory/logs/fin_wallets.log
StandardError=append:/srv/memory/logs/fin_wallets.log
