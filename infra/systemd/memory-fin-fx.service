[Unit]
Description=Daily FX rates (fiat → USD) for the budget module
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/fin_fx
EnvironmentFile=/srv/memory/secrets/.env
ExecStart=/srv/memory/apps/fin_fx/.venv/bin/python -m fin_fx
StandardOutput=append:/srv/memory/logs/fin_fx.log
StandardError=append:/srv/memory/logs/fin_fx.log
