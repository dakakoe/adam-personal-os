[Unit]
Description=Generate today's recurring task instances from active routines
After=network.target memory-merge-api.service
Wants=memory-merge-api.service

[Service]
Type=oneshot
User=ops
EnvironmentFile=/srv/memory/secrets/.env
# Idempotent: the endpoint skips any (routine, day) already materialized, so a
# missed/retried firing is harmless. Pure DB — no LLM, no external API.
ExecStart=/bin/bash -lc 'curl -fsS -X POST -H "Authorization: Bearer $MERGE_API_BEARER_TOKEN" http://127.0.0.1:9100/api/routines/generate'
StandardOutput=append:/srv/memory/logs/routines.log
StandardError=append:/srv/memory/logs/routines.log
