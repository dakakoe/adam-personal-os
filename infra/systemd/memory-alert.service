[Unit]
Description=Push-alert worker → Telegram on degraded health / low Anthropic credits
After=network.target memory-merge-api.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/alerter
EnvironmentFile=/srv/memory/secrets/.env
ExecStart=/srv/memory/apps/alerter/.venv/bin/python -m alerter
StandardOutput=append:/srv/memory/logs/alert.log
StandardError=append:/srv/memory/logs/alert.log
