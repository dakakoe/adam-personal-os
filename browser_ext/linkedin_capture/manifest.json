{
  "manifest_version": 3,
  "name": "ADAM — LinkedIn capture",
  "version": "1.0.0",
  "description": "Read the LinkedIn profile you're on and add it to ADAM as a contact.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://merge.example.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this profile to ADAM"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
