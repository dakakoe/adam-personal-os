# Copy this file to .env and fill in real values.
# .env is gitignored and never leaves the droplet's /srv/memory/secrets/ directory.
# Generate strong secrets with: openssl rand -base64 32

# ---- Postgres ----
POSTGRES_USER=memory
POSTGRES_PASSWORD=CHANGEME_run_openssl_rand_base64_32
POSTGRES_DB=memory

# ---- Twenty CRM ----
TWENTY_APP_SECRET=CHANGEME_run_openssl_rand_base64_32
TWENTY_SERVER_URL=https://crm.example.com
TWENTY_PG_DATABASE_URL=postgres://memory:CHANGEME_same_as_POSTGRES_PASSWORD@postgres:5432/twenty

# ---- Caddy ----
CADDY_DOMAIN_MCP=memory.example.com
CADDY_DOMAIN_CRM=crm.example.com
CADDY_EMAIL=admin@example.com

# ---- Telethon (filled in during application phase) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ---- Anthropic (for summarization) ----
ANTHROPIC_API_KEY=

# ---- OpenAI (only if using Whisper API instead of local) ----
OPENAI_API_KEY=

# ---- Telegram capture bot (voice/text → task/opp/event) ----
# Reuses ALERT_TG_BOT_TOKEN / ALERT_TG_CHAT_ID (the @yourbot alert bot).
BOT_ALLOWED_CHAT_ID=            # defaults to ALERT_TG_CHAT_ID
# Work Google account that calendar events are created on (must be re-consented
# with the calendar.events scope via fetchers/gmail oauth.py --scopes calendar-write).
BOT_WORK_CALENDAR_ACCOUNT=

# ---- Crypto transfer feed (operational wallets) ----
# Full-history transfer ingestion, all free tiers:
#   ALCHEMY_API_KEY  — getAssetTransfers for ETH/Base/Arbitrum/Optimism/Polygon
#                      (full archive history, native+ERC-20+internal). alchemy.com
#   NODEREAL_API_KEY — BSC archive RPC (getLogs without log pruning). nodereal.io
#   HELIUS_API_KEY   — Solana transaction history. helius.dev
#   TRONGRID_API_KEY — optional; TronGrid (Tron) works keyless, key = higher limits
#   ETHERSCAN_API_KEY— legacy/ad-hoc; superseded by Alchemy for the transfer feed
# Absent → that chain's transfer sync is skipped; balance sync is unaffected.
ALCHEMY_API_KEY=
NODEREAL_API_KEY=
HELIUS_API_KEY=
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# ---- Backup destination (filled in during Phase 7) ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=memory-backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# Keep the newest N off-site DB dumps (default 7). Media is never pruned.
BACKUP_REMOTE_KEEP=7

# ---- Backup encryption (age) ----
# Public recipient key (age1...). Generate a keypair OFF the droplet:
#   age-keygen -o ~/.config/memory/backup-age.key   # PRIVATE — never on the droplet
# Put ONLY the "Public key: age1..." line here. With this set, off-site DB dumps
# and all media are encrypted before upload; B2 only ever holds ciphertext.
# Losing the PRIVATE key = unrecoverable backups, so store it in your password
# manager too. Restore on a recovery machine needs BACKUP_AGE_IDENTITY=<path to
# the private key> (NOT set here on the droplet).
BACKUP_AGE_RECIPIENT=

# ---- Media backup (voice notes, …) ----
# Space-separated dir names under /srv/memory/data/ to back up incrementally.
# MUST be quoted — this file is `source`d by bash, and an unquoted space makes
# the second word run as a command (breaks every script that sources .env).
BACKUP_MEDIA_DIRS="voice bot_voice"

# ---- Local LLM (Ollama) ----
# ADAM routes privacy-sensitive AI work to a LOCAL model (nightly digest,
# sensitive-contact profiles/drafts/suggestions, the MCP local_ask tool).
# The distribution bundles NO model — you pull one with Ollama at install and
# name it here. Every service inherits this one value; per-role overrides
# (MAIL_ML_OLLAMA_MODEL, PROFILE_OLLAMA_MODEL, …) exist but you rarely need them.
#
# Pick for your server (see deploy/ollama/README.md for the full table + licenses):
#   under 8 GB RAM   → leave blank + skip Ollama; cloud-only, features degrade gracefully
#   8 GB             → llama3.2:3b  (permissive license — the safe friend-install default)
#                      or qwen2.5:3b (stronger multilingual/RU, but research license)
#   16 GB+           → a 7–8B model (e.g. llama3.1:8b) for noticeably better drafts
# Then: `ollama pull <that model>` on the server before starting the workers.
OLLAMA_MODEL=llama3.2:3b

# ---- Self-reference (used in AI prompts + finance audit labels) ----
# Your name/handle as the app should refer to you. Real value goes here in your
# private .env; the code default is generic.
PLANNER_SELF_LABEL=me
SCANNER_SELF_LABEL=me
# How the capture/draft prompts NAME you in generated output — meeting titles
# ("<you> <> Counterparty") and email sign-offs. Set this to your actual name,
# or the model writes the literal words "the user".
MERGE_API_SELF_LABEL=Your Name
# Your own LinkedIn /in/ URL, so imports don't treat you as a contact.
LINKEDIN_SELF_PROFILE_URL=
# Names as they print on your bank slips, so a "transfer to <you>" is detected
# as an own-account move (not spending) and paired by the finance leg-matcher.
# A case-insensitive regex ALTERNATION of the name fragments; empty = off.
# Example: FINANCE_SELF_NAMES='smith|m(?:r|ister)\.? *john|mrs?\.? *jane'
FINANCE_SELF_NAMES=
