[Unit]
Description=Weekly self-gating SetFit retrain (promote only if acc >= gate)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ops
WorkingDirectory=/srv/memory/apps/mail_ml
EnvironmentFile=/srv/memory/secrets/.env
Environment=MAIL_ML_MODEL_DIR=/srv/memory/data/mail_ml/model
Environment=OMP_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false
# The training working set is ~0.8GB on macOS (same setfit/torch) but the process
# holds 2.3–2.9GB RSS here, and the box has ~2.3GB free at 03:00 — Oct 4 → Nov 1
# all died in a global OOM (exit 137). The host's 4G swapfile (README) absorbs
# that peak. MALLOC_ARENA_MAX=2 was a guess at the Linux-only overhead; a capped
# probe (Nov 4) still went past 1.5GB with it, so it is not the fix on its own.
Environment=MALLOC_ARENA_MAX=2
# If it still doesn't fit, the kernel should kill this retryable job, not
# Postgres or a long-running API.
OOMScoreAdjust=500
# ~72 min at 150/class on 4 vCPU; a wedged run must die loudly and release the
# flock rather than hold the model lock forever. TimeoutStartSec, not
# RuntimeMaxSec: systemd ignores RuntimeMaxSec for Type=oneshot, so the old cap
# never applied (the default start timeout is off for oneshot).
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/srv/memory/apps/mail_ml/retrain.sh
StandardOutput=append:/srv/memory/logs/mail_ml_retrain.log
StandardError=append:/srv/memory/logs/mail_ml_retrain.log
